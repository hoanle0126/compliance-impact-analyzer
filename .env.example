# ImpactLens Compliance Impact Analyzer Environment Configuration
COMPOSE_PROJECT_NAME=impactlens
NODE_ENV=development

# API Server
PORT=4201
CORS_ORIGIN=http://localhost:3201

# Web Frontend
WEB_PORT=3201
NEXT_PUBLIC_API_URL=http://localhost:4201/api

# Database (PostgreSQL isolated port 55433)
DATABASE_URL=postgresql://impactlens_user:impactlens_password@localhost:55433/impactlens_db?schema=public

# Cache & Message Queue (Redis isolated port 6383)
REDIS_HOST=localhost
REDIS_PORT=6383
REDIS_PASSWORD=

# Security & Auth
JWT_SECRET=impactlens_secure_jwt_secret_compliance_safety_token_2026
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# AI Provider Configuration (mock | openai | gemini | anthropic)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=mock-v1
MAX_TOKENS=2000
LLM_TIMEOUT_MS=15000

# Integrations
REGTRACKER_WEBHOOK_SECRET=regtracker_secret_hmac_key_2026
LEGAL_RAG_API_URL=http://localhost:5436/api/rag
LEGAL_RAG_API_KEY=test_rag_key
LEGAL_RAG_TIMEOUT_MS=5000
